generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  APPROVER
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())

  users     User[]
  invoices  Invoice[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  role         Role
  orgId        String
  createdAt    DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  customer  String
  status    InvoiceStatus @default(DRAFT)
  subtotal  Decimal       @db.Decimal(12, 2)
  tax       Decimal       @db.Decimal(12, 2)
  total     Decimal       @db.Decimal(12, 2)
  orgId     String
  createdAt DateTime      @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  lineItems    LineItem[]

  @@unique([orgId, number])
  @@index([orgId])
  @@index([orgId, status])
}

model LineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  invoiceId   String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
